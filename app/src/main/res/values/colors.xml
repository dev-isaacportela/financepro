<?xml version="1.0" encoding="utf-8"?>
<!--
  Os dois canvas de design.md §4, em XML, só para o tema de plataforma ter o que
  pintar antes do Compose assumir. A fonte de verdade continua sendo
  core/ui/theme/Color.kt; estes dois existem porque `windowBackground` não é
  Compose e não enxerga os tokens.

  São o único par de cores do app fora de core/ui/theme, e por isso o único que
  o TokenLintTest não alcança: quem trocar CanvasDark tem de trocar aqui na mão,
  senão a barra de status fica um degrau fora do fundo que o Compose pinta.
-->
<resources>
    <color name="paper">#FFFFFF</color>
    <color name="paper_dark">#000000</color>
</resources>
