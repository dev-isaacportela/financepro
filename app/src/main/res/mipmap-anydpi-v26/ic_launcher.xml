<?xml version="1.0" encoding="utf-8"?>
<!--
  So `anydpi-v26`, e sem um unico PNG: `minSdk = 26` e exatamente onde o icone
  adaptativo entrou, entao nao existe aparelho suportado que caia num fallback
  de bitmap. Densidade tambem nao se aplica — o vetor e a mesma fonte para todas.

  Sem `roundIcon` no manifesto: o launcher ja aplica a mascara que ele usa sobre
  as camadas daqui, e um segundo arquivo identico so daria duas coisas para
  divergirem.

  **Aqui e onde cobalto mora.** O sistema de origem gasta a cor da marca em um
  lugar por pagina, e o app nao tem o card em destaque que a receberia
  (design.md §7). O icone do launcher e esse um lugar: e a unica superficie do
  produto que nao esta dentro de nenhum dos dois canvas, e a unica que precisa
  se distinguir de trinta vizinhos numa grade. Branco sobre cobalto da 6.06:1.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/marca" />
    <foreground android:drawable="@drawable/ic_marca_launcher" />
    <monochrome android:drawable="@drawable/ic_marca_launcher" />
</adaptive-icon>
